</footer>

<style>
  .snow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .snow span {
    position: absolute;
    top: -2rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9rem;
    user-select: none;
    animation-name: snow-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
    text-shadow: 0 0 6px rgba(255, 255, 255, 0.25);
  }
  @keyframes snow-fall {
    0% {
      transform: translate3d(0, -2rem, 0) rotate(0deg);
      opacity: 0;
    }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% {
      transform: translate3d(2rem, 100vh, 0) rotate(360deg);
      opacity: 0;
    }
  }
  /* 20 flakes: varied left, duration, delay, size */
  .snow span:nth-child(1)  { left:  3%; font-size: 0.8rem;  animation-duration: 11s; animation-delay: 0s; }
  .snow span:nth-child(2)  { left:  9%; font-size: 1.2rem;  animation-duration: 14s; animation-delay: 1.5s; }
  .snow span:nth-child(3)  { left: 15%; font-size: 0.75rem; animation-duration: 10s; animation-delay: 3s; }
  .snow span:nth-child(4)  { left: 21%; font-size: 1rem;    animation-duration: 13s; animation-delay: 0.5s; }
  .snow span:nth-child(5)  { left: 27%; font-size: 0.9rem;  animation-duration: 12s; animation-delay: 4s; }
  .snow span:nth-child(6)  { left: 33%; font-size: 1.1rem;  animation-duration: 15s; animation-delay: 2s; }
  .snow span:nth-child(7)  { left: 39%; font-size: 0.7rem;  animation-duration: 9s;  animation-delay: 5s; }
  .snow span:nth-child(8)  { left: 45%; font-size: 1rem;    animation-duration: 12s; animation-delay: 1s; }
  .snow span:nth-child(9)  { left: 51%; font-size: 0.85rem; animation-duration: 11s; animation-delay: 6s; }
  .snow span:nth-child(10) { left: 57%; font-size: 1.3rem;  animation-duration: 16s; animation-delay: 0s; }
  .snow span:nth-child(11) { left: 63%; font-size: 0.8rem;  animation-duration: 10s; animation-delay: 3.5s; }
  .snow span:nth-child(12) { left: 69%; font-size: 1rem;    animation-duration: 13s; animation-delay: 2.5s; }
  .snow span:nth-child(13) { left: 75%; font-size: 0.75rem; animation-duration: 11s; animation-delay: 5.5s; }
  .snow span:nth-child(14) { left: 81%; font-size: 1.1rem;  animation-duration: 14s; animation-delay: 1s; }
  .snow span:nth-child(15) { left: 87%; font-size: 0.9rem;  animation-duration: 12s; animation-delay: 4.5s; }
  .snow span:nth-child(16) { left: 93%; font-size: 0.85rem; animation-duration: 11s; animation-delay: 2s; }
  .snow span:nth-child(17) { left:  6%; font-size: 1rem;    animation-duration: 13s; animation-delay: 7s; }
  .snow span:nth-child(18) { left: 36%; font-size: 0.7rem;  animation-duration: 10s; animation-delay: 8s; }
  .snow span:nth-child(19) { left: 66%; font-size: 0.95rem; animation-duration: 12s; animation-delay: 7.5s; }
  .snow span:nth-child(20) { left: 96%; font-size: 1.05rem; animation-duration: 15s; animation-delay: 6.5s; }

  @media (prefers-reduced-motion: reduce) {
    .snow { display: none; }
  }
</style>
