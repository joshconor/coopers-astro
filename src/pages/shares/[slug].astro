---
// One page per share at /shares/<slug> — the landing page Google Merchant
// Center links each product to. Content comes from src/data/products.ts.
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
const priceNumber = p.price.replace(/[^0-9.]/g, "");
const pageUrl = `https://coopersgrassfedbeef.com/shares/${p.slug}`;
const imageUrl = p.image ? new URL(p.image.src, "https://coopersgrassfedbeef.com").href : undefined;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${p.name} Share — Coopers Grass Fed Beef`,
  description: p.longDesc ?? `${p.shortDesc} ${p.note ?? ""}`.trim(),
  image: imageUrl,
  brand: { "@type": "Brand", name: "Coopers Grass Fed Beef" },
  sku: p.slug,
  offers: {
    "@type": "Offer",
    url: pageUrl,
    priceCurrency: "USD",
    price: priceNumber,
    availability: p.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    itemCondition: "https://schema.org/NewCondition",
  },
};
---

<Layout
  title={`${p.name} Share — ${p.price} | Coopers Grass Fed Beef`}
  description={`${p.shortDesc} 100% grass-fed, vacuum-sealed, flash-frozen and shipped nationwide from Amarillo, TX.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="py-12 md:py-20 bg-surface-soft">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <a href="/#shop" class="inline-block text-[14px] text-ink-muted hover:text-pasture mb-6">&larr; All shares</a>

      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">
        <div class="bg-white rounded-3xl overflow-hidden ring-1 ring-black/5 relative">
          {p.image && (
            <Image
              src={p.image}
              alt={`${p.name} — 100% grass fed beef from Coopers`}
              class="w-full aspect-square object-cover"
              widths={[600, 900, 1200]}
              sizes="(max-width: 768px) 92vw, 560px"
            />
          )}
          {p.badge && (
            <div class="absolute top-4 left-4 bg-gold text-pasture text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow">
              {p.badge}
            </div>
          )}
        </div>

        <div>
          <div class="text-[13px] font-semibold uppercase tracking-[0.18em] text-gold mb-3">Coopers Grass Fed Beef</div>
          <h1 class="font-sans font-bold text-[clamp(2rem,4.5vw,3rem)] tracking-tight text-pasture leading-[1.05]">{p.name}</h1>
          <div class="mt-3 text-pasture font-bold text-[30px]">{p.price}</div>
          <p class="mt-3 text-[17px] text-ink-muted leading-relaxed">{p.shortDesc}</p>

          {(p.hangingWeight || p.packagedYield || p.freezerSpace) && (
            <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-6 text-[14px]">
              {p.hangingWeight && (
                <div class="bg-white rounded-xl px-4 py-3 ring-1 ring-black/5">
                  <dt class="text-[11px] uppercase tracking-wider font-semibold text-ink-muted mb-0.5">Hanging Weight</dt>
                  <dd class="font-semibold text-ink">{p.hangingWeight}</dd>
                </div>
              )}
              {p.packagedYield && (
                <div class="bg-white rounded-xl px-4 py-3 ring-1 ring-black/5">
                  <dt class="text-[11px] uppercase tracking-wider font-semibold text-ink-muted mb-0.5">Packaged Yield</dt>
                  <dd class="font-semibold text-ink">{p.packagedYield}</dd>
                </div>
              )}
              {p.freezerSpace && (
                <div class="bg-white rounded-xl px-4 py-3 ring-1 ring-black/5">
                  <dt class="text-[11px] uppercase tracking-wider font-semibold text-ink-muted mb-0.5">Freezer Space</dt>
                  <dd class="font-semibold text-ink">{p.freezerSpace}</dd>
                </div>
              )}
            </dl>
          )}

          <div class="mt-7 flex flex-col sm:flex-row gap-3">
            {p.available && p.buyUrl && (
              <a
                href={p.buyUrl}
                class="inline-flex items-center justify-center bg-gold text-pasture font-bold text-[16px] px-6 py-3.5 rounded-full hover:brightness-95 transition flex-1"
              >
                Buy now — {p.price}
              </a>
            )}
            <a
              href="/#order"
              class="inline-flex items-center justify-center bg-pasture text-white font-semibold px-6 py-3.5 rounded-full hover:bg-pasture-dark transition flex-1"
            >
              {p.available ? "Order this share" : "Notify me"}
            </a>
          </div>
          <p class="mt-3 text-[13px] text-ink-muted">
            Secure card checkout through Stripe, or order with a $500 deposit using the order form.
          </p>
        </div>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div class="md:col-span-2 bg-white rounded-3xl p-7 md:p-9 ring-1 ring-black/5">
          {p.note && <p class="text-[16px] text-ink-muted leading-relaxed mb-5">{p.note}</p>}
          {p.cuts && p.cuts.length > 0 && (
            <>
              <h2 class="text-[13px] font-semibold uppercase tracking-[0.16em] text-gold mb-3">What's Inside</h2>
              <ul class="space-y-2 mb-5">
                {p.cuts.map((cut) => (
                  <li class="flex gap-2 text-[15px] text-ink leading-relaxed">
                    <span class="text-gold flex-shrink-0 mt-1">•</span>
                    <span>{cut}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          {p.plus && <p class="text-[14px] text-ink-muted italic leading-relaxed">{p.plus}</p>}
          {p.longDesc && !p.cuts && (
            <>
              <h2 class="text-[13px] font-semibold uppercase tracking-[0.16em] text-gold mb-3">What's Inside</h2>
              <p class="text-[15px] text-ink leading-relaxed">{p.longDesc}</p>
            </>
          )}
        </div>

        <aside class="bg-white rounded-3xl p-7 ring-1 ring-black/5 text-[14px] text-ink-muted leading-relaxed space-y-4">
          <div>
            <h3 class="font-semibold text-pasture mb-1">Shipping</h3>
            <p>Shipped nationwide, vacuum-sealed and flash-frozen in insulated boxes. Orders process in 1–4 business days and arrive in 2–5 business days total.</p>
          </div>
          <div>
            <h3 class="font-semibold text-pasture mb-1">Returns &amp; damage</h3>
            <p>If your order arrives damaged, thawed or not as described, contact us within 48 hours of delivery with a photo and we'll replace or refund the affected portion. <a href="/#faq" class="underline">Full policy</a></p>
          </div>
          <div>
            <h3 class="font-semibold text-pasture mb-1">Questions?</h3>
            <p>Call <a href="tel:+12542189863" class="underline">(254) 218-9863</a> or email <a href="mailto:Coopersgrassfedbeef@gmail.com" class="underline">Coopersgrassfedbeef@gmail.com</a>.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
