---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact & Customer Support — Coopers Grass Fed Beef"
  description="Reach Coopers Grass Fed Beef for order help, cut-sheet questions, shipping updates, or refund requests. Based in Amarillo, TX."
>
  <section class="bg-cream">
    <div class="max-w-3xl mx-auto px-5 md:px-8 py-16 md:py-24">
      <nav class="text-[13px] text-ink/50 mb-6">
        <a href="/" class="hover:text-pasture transition">Home</a>
        <span class="mx-2">/</span>
        <span>Contact</span>
      </nav>

      <div class="text-[12px] font-semibold uppercase tracking-[0.18em] text-gold mb-3">Customer Support</div>
      <h1 class="font-display text-[clamp(2rem,4.5vw,3rem)] tracking-tight text-ink leading-[1.1]">
        We're a family — not a call center.
      </h1>
      <p class="mt-4 text-[16px] text-ink/70 leading-relaxed max-w-2xl">
        Questions about your order, the cut sheet, shipping, or a refund?
        Reach out any of the ways below and you'll get a real person from the
        Cooper family. We reply within 1 hour during business hours.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a
          href="tel:2542189863"
          class="group bg-white border border-black/10 rounded-2xl p-6 hover:border-pasture hover:shadow-lg transition"
        >
          <div class="text-[12px] font-semibold uppercase tracking-[0.14em] text-pasture mb-2">Call or Text</div>
          <div class="font-display text-2xl text-ink group-hover:text-pasture transition">(254) 218-9863</div>
          <div class="mt-2 text-[14px] text-ink/60">Fastest way to reach us.</div>
        </a>

        <a
          href="mailto:Coopersgrassfedbeef@gmail.com"
          class="group bg-white border border-black/10 rounded-2xl p-6 hover:border-pasture hover:shadow-lg transition"
        >
          <div class="text-[12px] font-semibold uppercase tracking-[0.14em] text-pasture mb-2">Email</div>
          <div class="font-display text-[20px] text-ink group-hover:text-pasture transition break-all">
            Coopersgrassfedbeef@gmail.com
          </div>
          <div class="mt-2 text-[14px] text-ink/60">Best for order details and photos.</div>
        </a>
      </div>

      <div class="mt-6 bg-white border border-black/10 rounded-2xl p-6 md:p-8">
        <h2 class="font-display text-2xl text-ink mb-4">Business Hours</h2>
        <div class="text-[15px] text-ink/80 leading-relaxed">
          <div><strong>Monday–Friday:</strong> 8:00 AM – 7:00 PM</div>
          <div><strong>Saturday:</strong> 9:00 AM – 5:00 PM</div>
          <div><strong>Sunday:</strong> Closed</div>
          <div class="mt-3 text-[13px] text-ink/60">
            All hours are in <strong>Central Time (CT)</strong> — our local time
            in Amarillo, TX. Messages received outside business hours are
            answered the next morning.
          </div>
        </div>
      </div>

      <div class="mt-6 bg-white border border-black/10 rounded-2xl p-6 md:p-8">
        <h2 class="font-display text-2xl text-ink mb-4">Mailing Address</h2>
        <address class="not-italic text-[15px] text-ink/80 leading-relaxed">
          Coopers Grass Fed Beef<br />
          3201 Barry Dean Dr<br />
          Amarillo, TX
        </address>
        <p class="mt-3 text-[13px] text-ink/60">
          Local pickup is by appointment only — please call or email first.
        </p>
      </div>

      <div class="mt-6 bg-pasture/5 border border-pasture/20 rounded-2xl p-6 md:p-8">
        <h2 class="font-display text-2xl text-ink mb-3">Refund or Order Issue?</h2>
        <p class="text-[15px] text-ink/80 leading-relaxed">
          If your order arrived <strong>thawed, damaged, or with missing packages</strong>,
          please contact us within <strong>24 hours of delivery (Central Time)</strong> with
          photos of the boxes and contents. See our full
          <a href="/policies" class="text-pasture font-semibold hover:underline">Refund, Cancellation &amp; Fulfillment Policies</a>
          for details.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-block bg-pasture text-white font-semibold px-6 py-3 rounded-full hover:bg-pasture/90 transition"
        >
          Back to Home
        </a>
        <a
          href="/policies"
          class="inline-block bg-transparent text-pasture border border-pasture/30 font-semibold px-6 py-3 rounded-full hover:bg-pasture/5 transition"
        >
          Read Our Policies
        </a>
      </div>
    </div>
  </section>
</Layout>
