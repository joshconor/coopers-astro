---
import Layout from "../layouts/Layout.astro";
import {
  ADS_ID,
  ADS_CONVERSION_LABEL,
  GA_ID,
  GA_CONVERSION_EVENT,
} from "../config/analytics";

// Full "send_to" target for the Google Ads conversion event,
// e.g. "AW-123456789/AbC-D_efGhIjKlMnOp". Empty until both IDs are pasted.
const ADS_SEND_TO =
  ADS_ID && ADS_CONVERSION_LABEL ? `${ADS_ID}/${ADS_CONVERSION_LABEL}` : "";
---

<Layout
  title="Thank You — Coopers Grass Fed Beef"
  description="Your order inquiry has been received. We'll reply within 1 hour during business hours with payment instructions."
  noindex
>
  <section class="bg-pasture relative overflow-hidden">
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-gold/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-white/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto px-5 md:px-8 py-20 md:py-28">
      <div class="text-center">
        <div class="mx-auto mb-8 w-20 h-20 rounded-full bg-white flex items-center justify-center shadow-2xl shadow-black/20">
          <svg class="w-10 h-10 text-pasture" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="text-[13px] font-semibold uppercase tracking-[0.18em] text-gold mb-3">Order Inquiry Received</div>
        <h1 class="font-sans font-bold text-[clamp(2rem,4.5vw,3.5rem)] tracking-tight text-white leading-[1.05]">
          Thank you &mdash; we have it.
        </h1>
        <p class="mt-5 text-[17px] text-white/75 max-w-xl mx-auto leading-relaxed">
          Your order inquiry is in. We reply within 1 hour during business
          hours to confirm availability and send payment instructions for the
          method you chose.
        </p>
      </div>

      <div class="mt-10 bg-white/[0.06] border border-white/10 rounded-2xl p-6 md:p-8 backdrop-blur-sm">
        <h2 class="font-display text-2xl text-white mb-4">What happens next</h2>
        <ol class="space-y-4 text-white/80 leading-relaxed list-decimal pl-5 marker:text-gold marker:font-semibold">
          <li>
            <strong class="text-white">We confirm availability</strong> and reply
            within 1 hour during business hours &mdash; check your email, and
            your spam folder just in case.
          </li>
          <li>
            <strong class="text-white">You send your deposit</strong> using the
            method you picked. We send those details directly; we never post
            payment handles on the website.
          </li>
          <li>
            <strong class="text-white">We walk you through the cut sheet</strong>
            &mdash; steak thickness, roast sizes, how much you want ground.
          </li>
          <li>
            <strong class="text-white">Your beef ships.</strong> Vacuum sealed,
            flash frozen, packed with dry ice. Most orders leave within 1&ndash;4
            business days and arrive 1&ndash;3 business days later.
          </li>
        </ol>
      </div>

      <div class="mt-6 bg-white/[0.06] border border-white/10 rounded-2xl p-6 md:p-8 backdrop-blur-sm">
        <h2 class="font-display text-2xl text-white mb-3">Need us sooner?</h2>
        <p class="text-white/80 leading-relaxed">
          Call or text
          <a href="tel:2542189863" class="text-gold font-semibold hover:underline">(254) 218-9863</a>,
          or email
          <a href="mailto:Coopersgrassfedbeef@gmail.com" class="text-gold font-semibold hover:underline">Coopersgrassfedbeef@gmail.com</a>.
          We&rsquo;re a family, not a call center &mdash; you&rsquo;ll get one of us.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3 justify-center">
        <a
          href="tel:2542189863"
          class="inline-block bg-white text-pasture font-semibold px-8 py-4 rounded-full hover:bg-gold hover:text-ink transition shadow-lg shadow-black/20"
        >
          Call (254) 218-9863
        </a>
        <a
          href="/"
          class="inline-block bg-transparent text-white border border-white/30 font-semibold px-8 py-4 rounded-full hover:bg-white/10 transition"
        >
          Back to Home
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ ADS_SEND_TO, GA_ID, GA_CONVERSION_EVENT }}>
  if (typeof window.gtag === "function") {
    // Native Google Ads conversion — only when a conversion action was
    // created directly in Ads and has its own label.
    if (ADS_SEND_TO) {
      window.gtag("event", "conversion", { send_to: ADS_SEND_TO });
    }
    // GA4 key event. This is the path a GA4-imported Ads conversion uses:
    // GA4 receives it, then forwards it to Ads via the linked accounts.
    // send_to targets the GA property so Ads never double-counts it.
    if (GA_ID) {
      window.gtag("event", GA_CONVERSION_EVENT, {
        send_to: GA_ID,
        form_name: "order_inquiry",
      });
    }
  }
</script>
